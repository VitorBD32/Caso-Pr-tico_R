# Instalar e carregar os pacotes necessários
if (!requireNamespace("readr", quietly = TRUE)) install.packages("readr")
if (!requireNamespace("ggplot2", quietly = TRUE)) install.packages("ggplot2")
if (!requireNamespace("dplyr", quietly = TRUE)) install.packages("dplyr")

library(readr)
library(ggplot2)
library(dplyr)

# Caminho CSV
caminho_arquivo <- "E:/CIÊNCIAS DA COMPUTAÇÃO/5º PERÍODO/Atividade de Extensão 4/ESTUDO DE CASO/Base de dados de Registros de Aquicultores(in).csv"

# Ler o arquivo CSV com delimitador ";"
planilha <- read_delim(caminho_arquivo, 
                      delim = ";", 
                      locale = locale(encoding = "ISO-8859-1"), 
                      col_names = TRUE, 
                      show_col_types = FALSE)

# Exibir as primeiras linhas do conjunto de dados
head(planilha)

# Exibir o conjunto de dados completo em uma aba separada
View(planilha)


# Contar o número de registros para cada atividade por gênero
atividade_genero_counts <- planilha %>%
  group_by(`Tipo de atividade`, Gênero) %>%
  summarise(Count = n())

# Criar o gráfico de barra
ggplot(atividade_genero_counts, aes(x = `Tipo de atividade`, y = Count, fill = Gênero)) +
  geom_bar(stat = "identity", position = "dodge") +
  labs(title = "Distribuição das Atividades de Aquicultura por Gênero",
       x = "Atividade",
       y = "Número de Registros") +
  theme_minimal() +
  theme(
    panel.background = element_rect(fill = "white", color = "white"),  # Fundo branco do painel
    plot.background = element_rect(fill = "white", color = "white"),  # Fundo branco do gráfico
    axis.text.x = element_text(angle = 45, hjust = 1) # Rotacionar os rótulos do eixo x para melhor legibilidade
  )

# Salvar o gráfico em um arquivo
ggsave("distribuicao_atividades_aquicultura_genero.png")